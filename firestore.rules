rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPlayerProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 1000000 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000 &&
             data.balloonBestScore is int && data.balloonBestScore >= 0 && data.balloonBestScore <= 100000 &&
             data.memoryBestScore is int && data.memoryBestScore >= 0 && data.memoryBestScore <= 100000 &&
             data.mathBestScore is int && data.mathBestScore >= 0 && data.mathBestScore <= 100000 &&
             data.xylophoneBestScore is int && data.xylophoneBestScore >= 0 && data.xylophoneBestScore <= 100000 &&
             data.unlockedStickers is list && data.unlockedStickers.size() <= 20 &&
             (data.unlockedStickers.size() == 0 || data.unlockedStickers[0] is string) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGameSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.gameType in ['balloon_pop', 'memory_match', 'math_safari', 'xylophone'] &&
             data.score is int && data.score >= 0 && data.score <= 100000 &&
             data.starsEarned is int && data.starsEarned >= 0 && data.starsEarned <= 3 &&
             data.difficulty in ['easy', 'medium'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'totalStars', 'gamesPlayed',
                         'balloonBestScore', 'memoryBestScore', 'mathBestScore',
                         'xylophoneBestScore', 'unlockedStickers', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'totalStars', 'gamesPlayed',
                         'balloonBestScore', 'memoryBestScore', 'mathBestScore',
                         'xylophoneBestScore', 'unlockedStickers', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPlayerProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidPlayerProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'totalStars', 'gamesPlayed',
                         'balloonBestScore', 'memoryBestScore', 'mathBestScore',
                         'xylophoneBestScore', 'unlockedStickers', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);

      match /gameSessions/{sessionId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(sessionId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(sessionId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'gameType', 'score', 'starsEarned', 'difficulty', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'gameType', 'score', 'starsEarned', 'difficulty', 'createdAt'
                         ]) &&
                         isValidGameSession(incoming());

        allow update: if false;

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(sessionId);
      }
    }
  }
}
